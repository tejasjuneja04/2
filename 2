                              param_grid=param_grid, cv=cv, scoring="accuracy", verbose=1).fit(xtrain, ytrain)
    print(f"best params: {best_model.best_params_} | best CV score: {best_model.best_score_:.4f}")
    print(f"grid search test score: {best_model.score(xtest, ytest):.3f}")
