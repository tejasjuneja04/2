# ==================== START: ovr_ovo ====================
def ovr_ovo():
    header("LOGISTIC REGRESSION: ONE-VS-ALL and ONE-VS-ONE")
    df, _ = load()
    target = pick_target(df, "NObeyesdad")
    need_classes(df[target], target)
    df = df[list(FEATURES or [c for c in df.columns if c != target]) + [target]].dropna().reset_index(drop=True)
    print(f"Target: '{target}'\nClass balance:\n{df[target].value_counts()}")
    X = df.drop(columns=[target])
    cont = X.select_dtypes(include="float").columns.tolist()
    cat = [c for c in X.columns if not pd.api.types.is_numeric_dtype(X[c])]
    parts = [X.drop(columns=cont + cat)]
    if cont:
        parts.append(pd.DataFrame(StandardScaler().fit_transform(X[cont]), columns=cont))
    if cat:
        encoder = OneHotEncoder(sparse_output=False, drop="first")
        parts.append(pd.DataFrame(encoder.fit_transform(X[cat].astype(str)), columns=encoder.get_feature_names_out(cat)))
    x = pd.concat(parts, axis=1)
    y = df[target].astype("category")
    names, y = [str(c) for c in y.cat.categories], y.cat.codes
    x_train, x_test, y_train, y_test = split(x, y, strat=True)
    try:
        model_ova = LogisticRegression(multi_class="ovr", max_iter=1000)
    except TypeError:
        model_ova = OneVsRestClassifier(LogisticRegression(max_iter=1000))
    model_ova.fit(x_train, y_train)
    model_ovo = OneVsOneClassifier(LogisticRegression(max_iter=1000)).fit(x_train, y_train)
    a = report("One vs All (OvA)", model_ova, x_test, y_test, names)
    b = report("One vs One (OvO)", model_ovo, x_test, y_test, names)
    print(f"\nOvA accuracy: {np.round(100 * a, 2)}%  |  OvO accuracy: {np.round(100 * b, 2)}%")
    if SHOW_PLOTS:
        coef = model_ova.coef_ if hasattr(model_ova, "coef_") else np.vstack([e.coef_ for e in model_ova.estimators_])
