def tree_regressor():
    header("DECISION TREE REGRESSOR")
    df, _ = load()
    target = pick_target(df, "tip_amount")
    need_numeric(df[target], target)
    X, y = xy(df, target)
    if SHOW_PLOTS:
        pd.concat([X, y], axis=1).corr()[target].drop(target).plot(kind="barh", figsize=(10, 6))
        plt.title(f"correlation with {target}"); plt.show()
    x = normalize(X.values, axis=1, norm="l1", copy=False)
    x_train, x_test, y_train, y_test = split(x, y.values.astype("float32"), test=0.3)
    for depth in sorted({opt(MAX_DEPTH, 8), 8, 12}):
        dt_reg = DecisionTreeRegressor(criterion="squared_error", max_depth=depth, random_state=35).fit(x_train, y_train)
        y_pred = dt_reg.predict(x_test)
        print(f"max_depth={depth:2d} | mse score: {mean_squared_error(y_test, y_pred):.3f} | "
              f"r^2 score: {dt_reg.score(x_test, y_test):.3f}")
        if depth == opt(MAX_DEPTH, 8):
            main = dt_reg
    importance(main, list(X.columns), f"Decision tree regressor (max_depth={opt(MAX_DEPTH, 8)})", top=3)

