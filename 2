def simple_linear():
    header("SIMPLE LINEAR REGRESSION")
    df, _ = load()
    target = pick_target(df, "CO2EMISSIONS")
    need_numeric(df[target], target)
    num = df.drop(columns=[target]).select_dtypes("number")
    if num.empty and not FEATURES:
        raise SystemExit("No numeric feature column for linear regression -> set FEATURES")
    feat = (FEATURES or (["ENGINESIZE"] if "ENGINESIZE" in df.columns else [num.corrwith(df[target]).abs().idxmax()]))[0]
    d = df[[feat, target]].dropna()
    print(f"x = '{feat}'  ->  y = '{target}'")
    x, y = d[feat].to_numpy(), d[target].to_numpy()
    x_train, x_test, y_train, y_test = split(x, y)
    regressor = LinearRegression().fit(x_train.reshape(-1, 1), y_train)
    print("coefficient:", regressor.coef_[0])
    print("intercept:", regressor.intercept_)
    y_pred = regressor.predict(x_test.reshape(-1, 1))
    reg_report(y_test, y_pred)
    if SHOW_PLOTS:
        for xs, ys, part in [(x_train, y_train, "training"), (x_test, y_test, "test")]:
            plt.scatter(xs, ys, color="red", label=f"actual {part} data")
            plt.plot(xs, regressor.coef_[0] * xs + regressor.intercept_, "-b", label="regression line")
            plt.xlabel(feat); plt.ylabel(target); plt.title(f"Regression model on {part} data"); plt.legend(); plt.show()

