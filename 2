def logistic():
    header("LOGISTIC REGRESSION")
    df, names = load()
    target = pick_target(df, "churn")
    X, y = xy(df, target, ["tenure", "age", "address", "income", "ed", "employ", "equip"])
    need_classes(y, target)
    y, names = codes(y.astype(int) if pd.api.types.is_numeric_dtype(y) else y, names)
    x_norm = StandardScaler().fit(X).transform(X)
    x_train, x_test, y_train, y_test = split(x_norm, y, seed=4)
    LR = LogisticRegression().fit(x_train, y_train)
    yhat_prob = LR.predict_proba(x_test)
    print("predictions (first 10):", LR.predict(x_test)[:10])
    print("probabilities (first 5):\n", yhat_prob[:5].round(4))
    print(f"\nlog loss: {log_loss(y_test, yhat_prob, labels=LR.classes_):.4f}   (lower = better)")
    report("Logistic Regression", LR, x_test, y_test, names)
    if SHOW_PLOTS and LR.coef_.shape[0] == 1:
        pd.Series(LR.coef_[0], index=X.columns).sort_values().plot(kind="barh")
        plt.title("feature coefficients in logistic regression"); plt.xlabel("coefficient value"); plt.show()

