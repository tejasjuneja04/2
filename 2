# ==================== START: multiple_linear ====================
def multiple_linear():
    header("MULTIPLE LINEAR REGRESSION")
    df, _ = load()
    target = pick_target(df, "CO2EMISSIONS")
    need_numeric(df[target], target)
    num = df.select_dtypes("number").loc[:, lambda d: d.nunique() > 1]
    print("Correlation with target:\n", num.corr()[target].drop(target).round(3))
    if num.shape[1] < 2 and not FEATURES:
        raise SystemExit("No numeric feature columns for multiple linear regression -> set FEATURES")
    default = ["ENGINESIZE", "FUELCONSUMPTION_COMB", "FUELCONSUMPTION_COMB_MPG"]
    X, y = xy(df, target, default if set(default) <= set(df.columns) else list(num.columns))
    if SHOW_PLOTS:
        pd.plotting.scatter_matrix(pd.concat([X, y], axis=1), alpha=0.2, figsize=(8, 8)); plt.show()
    std_scaler = StandardScaler()
    x_std = std_scaler.fit_transform(X.to_numpy())
    x_train, x_test, y_train, y_test = split(x_std, y.to_numpy())
    regressor = LinearRegression().fit(x_train, y_train)
    coef_, intercept_ = regressor.coef_, regressor.intercept_
    print("coefficient (standardized):", coef_)
    print("intercept (standardized):", intercept_)
    std_devs = np.sqrt(std_scaler.var_)
    print("coefficient (original scale):", coef_ / std_devs)
    print("intercept (original scale):", intercept_ - np.sum(std_scaler.mean_ * coef_ / std_devs))
    reg_report(y_test, regressor.predict(x_test))

# ==================== END: multiple_linear ====================


