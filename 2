def opt(value, default):
    return default if value is None else value


def find_file(p):
    if p.startswith("http") or os.path.isfile(p):
        return p
    for d in [".", "~/Downloads", "~/Desktop", "~/Documents", "/kaggle/input"]:
        hits = glob.glob(os.path.join(os.path.expanduser(d), "**", os.path.basename(p)), recursive=True)
        if hits:
            return hits[0]
    raise SystemExit(f"File not found: {p}  -> check DATA_PATH")


def read_file(path):
    p = find_file(path.strip())
    ext = os.path.splitext(p.split("?")[0])[1].lower()
    head = b"" if p.startswith("http") else open(p, "rb").read(8)
    if ext in (".xlsx", ".xls", ".xlsm") or head[:2] in (b"PK", b"\xd0\xcf"):
        df = pd.read_excel(p)
    elif ext == ".json":
        df = pd.read_json(p)
    else:
        try:
            df = pd.read_csv(p)
        except UnicodeDecodeError:
            df = pd.read_csv(p, encoding="latin-1")
        if df.shape[1] == 1:
            df = pd.read_csv(p, sep=None, engine="python", encoding_errors="replace")
    df.columns = [str(c).strip() for c in df.columns]
    return df.loc[:, ~df.columns.str.startswith("Unnamed")]


def load(default=None):
    src = DATA_PATH.strip() or default
    if not src:
        raise SystemExit("This task needs a data file -> put its path in DATA_PATH")
    key = src.lower().replace("load_", "").replace("fetch_", "")
    if key in BUILTIN:
        b = BUILTIN[key]()
        df = pd.DataFrame(b.data, columns=[str(c) for c in b.feature_names])
        df["target"] = b.target
        return df, (list(b.target_names) if "target_names" in b else None)
    if key == "20newsgroups":
        try:
            b = datasets.fetch_20newsgroups(subset="all")
        except Exception:
            raise SystemExit("20newsgroups is not downloaded on this PC (needs internet once).")
        return pd.DataFrame({"text": b.data, "target": b.target}), list(b.target_names)
    if key == "paste":
        return pd.DataFrame(SENTENCES), None
    df = read_file(src)
    print(f"Loaded {src}  shape {df.shape}")
    return df, None


def pick_target(df, default=None):
    if TARGET and TARGET not in df.columns:
        print(f"!! TARGET '{TARGET}' not found. Columns: {list(df.columns)}")
    for t in (TARGET, default):
        if t and t in df.columns:
            return t
    low = {c.lower(): c for c in df.columns}
    return next((low[h] for h in HINTS if h in low), df.columns[-1])


def encode(X):
    X = X.copy()
    for c in X.columns:
        if not pd.api.types.is_numeric_dtype(X[c]) or pd.api.types.is_bool_dtype(X[c]):
            X[c] = LabelEncoder().fit_transform(X[c].astype(str))
    return X


def xy(df, target, default=None, drop=()):
    if FEATURES:
        missing = [f for f in FEATURES if f not in df.columns]
        if missing:
            raise SystemExit(f"FEATURES not found: {missing}. Columns: {list(df.columns)}")
    cols = FEATURES or (default if default and set(default) <= set(df.columns)
                        else [c for c in df.columns if c != target and c not in drop])
    cols = [c for c in cols if c != target]
    d = df[list(cols) + [target]].dropna()
    print(f"Target: '{target}' | features ({len(cols)}): {list(cols)}")
    return encode(d[list(cols)]), d[target]


def codes(y, names=None):
    if pd.api.types.is_numeric_dtype(y) and names is None:
        return np.asarray(y), None
    le = LabelEncoder()
    yy = le.fit_transform(y if pd.api.types.is_numeric_dtype(y) else y.astype(str))
    return yy, names or [str(c) for c in le.classes_]


def split(X, y, test=0.2, seed=42, strat=False):
    test, seed, strat = opt(TEST_SIZE, test), opt(SEED, seed), opt(STRATIFY, strat)
    ok = strat and pd.Series(np.asarray(y)).value_counts().min() >= 2
    print(f"train_test_split(test_size={test}, random_state={seed}, stratify={'y' if ok else None})")
    return train_test_split(X, y, test_size=test, random_state=seed, stratify=y if ok else None)


def need_numeric(y, target):
    if not pd.api.types.is_numeric_dtype(y):
        raise SystemExit(f"Target '{target}' is text ({list(y.unique()[:5])}...) -> this is CLASSIFICATION, "
                         f"not regression. Use logistic / decision_tree / knn / auto, or set TARGET.")


def need_classes(y, target):
    y = pd.Series(y).dropna()
    if pd.api.types.is_numeric_dtype(y) and not pd.api.types.is_bool_dtype(y) and (
            y.nunique() > 50 or (pd.api.types.is_float_dtype(y) and not np.all(np.mod(y, 1) == 0))):
        raise SystemExit(f"Target '{target}' is continuous ({y.nunique()} different numbers) -> this is REGRESSION. "
                         f"Use simple_linear / multiple_linear / tree_regressor / auto, or set TARGET.")


def is_classification(y):
    if not pd.api.types.is_numeric_dtype(y) or pd.api.types.is_bool_dtype(y):
        return True
    if pd.api.types.is_float_dtype(y) and not np.all(np.mod(y, 1) == 0):
        return False
    return y.nunique() <= max(20, 0.05 * len(y)) and y.nunique() < 0.5 * len(y)


def header(t):
    print("\n" + "=" * 70 + f"\n{t}\n" + "=" * 70)


def report(name, model, x_test, y_test, names=None):
    y_test = np.asarray(y_test)
    p = model.predict(x_test)
    cls = np.unique(np.concatenate([y_test, p]))
    lab = [str(names[c]) if names is not None and isinstance(c, (int, np.integer)) and c < len(names) else str(c)
           for c in cls]
    acc = accuracy_score(y_test, p)
    print(f"\n--- {name} ---\nAccuracy: {acc * 100:.2f}%  ({acc:.4f})\n")
    print(classification_report(y_test, p, labels=cls, target_names=lab, zero_division=0))
    cm = confusion_matrix(y_test, p, labels=cls)
    print("Confusion matrix:\n", cm)
    binary = len(cls) == 2
    kw = dict(average="binary", pos_label=cls[1]) if binary else dict(average="macro")
    pr, rc, f1 = (f(y_test, p, zero_division=0, **kw) for f in (precision_score, recall_score, f1_score))
    print(f"Precision {pr:.4f} | Recall {rc:.4f} | F1 {f1:.4f}  ({'positive class = ' + lab[1] if binary else 'macro'})")
    if binary:
        tn, fp, fn, tp = cm.ravel()
        print(f"TP={tp}  TN={tn}  FP={fp}  FN={fn}  |  Specificity TN/(TN+FP) = {tn / max(tn + fp, 1):.4f}")
        if hasattr(model, "predict_proba") and len(np.unique(y_test)) == 2:
            score = model.predict_proba(x_test)[:, list(model.classes_).index(cls[1])]
            auc = roc_auc_score(y_test == cls[1], score)
            print(f"ROC-AUC: {auc:.4f}")
            if SHOW_PLOTS:
                fpr, tpr, _ = roc_curve(y_test == cls[1], score)
                plt.figure(figsize=(5, 4)); plt.plot(fpr, tpr, label=f"AUC = {auc:.3f}"); plt.plot([0, 1], [0, 1], "--")
                plt.xlabel("False Positive Rate"); plt.ylabel("True Positive Rate"); plt.title(f"{name} ROC curve")
                plt.legend(); plt.show()
    if SHOW_PLOTS and len(cls) <= 25:
        plt.figure(figsize=(max(5, .6 * len(cls)), max(4, .5 * len(cls))))
        sns.heatmap(cm, annot=True, fmt="d", cmap="Blues", xticklabels=lab, yticklabels=lab)
        plt.title(f"{name} confusion matrix"); plt.xlabel("Predicted"); plt.ylabel("Actual"); plt.show()
    return acc


def reg_report(y_test, y_pred):
    mse = mean_squared_error(y_test, y_pred)
    print(f"mean absolute error: {mean_absolute_error(y_test, y_pred):.2f}")
    print(f"mean squared error: {mse:.3f}")
    print(f"root mean squared error: {np.sqrt(mse):.2f}")
    print(f"r2-score: {r2_score(y_test, y_pred):.3f}")
    return r2_score(y_test, y_pred)


def importance(model, cols, title, top=5):
    imp = model.feature_importances_
    idx = np.argsort(imp)[::-1]
    print(f"\nTop {min(top, len(idx))} important features ({title}):")
    for r, i in enumerate(idx[:top], 1):
        print(f"{r}. {cols[i]}: {imp[i]:.4f}")
    if SHOW_PLOTS:
        k = min(15, len(idx))
        plt.figure(figsize=(7, .35 * k + 1.5))
        plt.barh([cols[i] for i in idx[:k]][::-1], imp[idx[:k]][::-1], color="skyblue")
        plt.title(f"{title} feature importance"); plt.tight_layout(); plt.show()


def make_xgb(n_classes):
    if not HAS_XGB:
        print("(xgboost not installed -> sklearn GradientBoosting used instead)")
        return XGBClassifier(random_state=42)
    if n_classes > 2:
        return XGBClassifier(objective="multi:softprob", num_class=n_classes, random_state=42, eval_metric="mlogloss")
    return XGBClassifier(n_estimators=100, learning_rate=0.1, random_state=42, eval_metric="logloss")


def text_column(df, target, min_words=0):
    best, best_n = None, min_words
    for c in df.columns:
        if c != target and not pd.api.types.is_numeric_dtype(df[c]):
            n = df[c].dropna().astype(str).str.split().str.len().mean()
            if n > best_n:
                best, best_n = c, n
    return best


def text_data(default, max_df):
    df, names = load(default)
    target = pick_target(df, "sentiment")
    need_classes(df[target], target)
    tcol = text_column(df, target)
    if tcol is None:
        raise SystemExit(f"No text column found in {list(df.columns)}")
    d = df[[tcol, target]].dropna()
    print(f"Text column: '{tcol}' | target: '{target}' | rows: {len(d)}")
    y, names = codes(d[target] if names else d[target].astype(str), names)
    x_train, x_test, y_train, y_test = split(d[tcol].astype(str), y)
    vec = TfidfVectorizer(stop_words="english", lowercase=True, max_df=max_df)
    return vec, vec.fit_transform(x_train), vec.transform(x_test), y_train, y_test, names


