# ==================== START: data_cleaning ====================
def data_cleaning():
    header("DATA CLEANING + MERGE + SCALING + ENCODING + BINNING")
    customers = read_file(DATA_PATH or "customers_raw.csv").drop_duplicates()
    customers.columns = customers.columns.str.strip()
    print(customers.describe())
    id_col = next((c for c in customers.columns if c.lower().endswith("id")), None)
    numeric = [c for c in customers.columns if pd.api.types.is_numeric_dtype(customers[c])
               and not pd.api.types.is_bool_dtype(customers[c]) and c != id_col]
    for c in customers.columns:
        if c in numeric:
            customers[c] = customers[c].fillna(customers[c].median())
            q1, q3 = customers[c].quantile(0.25), customers[c].quantile(0.75)
            iqr = q3 - q1
            customers[c] = customers[c].clip(q1 - 1.5 * iqr, q3 + 1.5 * iqr)
        elif c != id_col and not pd.api.types.is_bool_dtype(customers[c]):
            customers[c] = customers[c].fillna("Unknown").astype(str).str.strip().str.title()
    print("\nAfter cleaning:\n", customers)
    merged = customers
    if DATA_PATH_2.strip():
        purchases = read_file(DATA_PATH_2)
        key = next((c for c in customers.columns if c in purchases.columns), None)
        if key is None:
            raise SystemExit("The two files have no common column to merge on")
        merged = pd.merge(customers, purchases, on=key, how="left")
        for c in purchases.columns:
            if c != key and pd.api.types.is_numeric_dtype(merged[c]) and not pd.api.types.is_bool_dtype(merged[c]):
                year_like = merged[c].dropna().between(1900, 2100).all()
                merged[c] = merged[c].fillna(merged[c].median() if year_like else 0)
        print(f"\nMerged on '{key}' (left join):\n", merged)
    df_t = merged.copy()
    if numeric:
        df_t[[f"{c.lower()}_minmax" for c in numeric]] = MinMaxScaler().fit_transform(df_t[numeric])
        df_t[[f"{c.lower()}_z" for c in numeric]] = StandardScaler().fit_transform(df_t[numeric])
    text = [c for c in merged.columns if not pd.api.types.is_numeric_dtype(merged[c]) and c != id_col]
    dummies = []
    for c in text:
        n = merged[c].nunique()
        if n == 2:
            df_t[f"{c.lower()}_encoded"] = LabelEncoder().fit_transform(df_t[c].astype(str))
        elif 2 < n <= 10 and n < 0.8 * len(merged):
            dummies.append(c)
    df_t = pd.get_dummies(df_t, columns=dummies, prefix=dummies)
    age = next((c for c in merged.columns if c.lower() == "age"), None)
    if age and pd.api.types.is_numeric_dtype(merged[age]):
        df_t["Age_group"] = pd.cut(merged[age], bins=[0, 25, 35, 50, 100], labels=["Young", "Adult", "Mid_age", "Senior"])
    buy = next((c for c in merged.columns if "purchase" in c.lower() and pd.api.types.is_numeric_dtype(merged[c])), None)
    if buy:
        bins = [-1, 5, 10, 15, max(20, merged[buy].max())]
        df_t["Loyalty_Group"] = pd.cut(merged[buy], bins=bins, labels=[1, 2, 3, 4])
        df_t["Loyalty_Amount"] = pd.cut(merged[buy], bins=bins, labels=[100, 200, 300, 400])
    pd.set_option("display.width", 250); pd.set_option("display.max_columns", 50)
    print("\nFinal transformed data:\n", df_t)
    return df_t

# ==================== END: data_cleaning ====================


